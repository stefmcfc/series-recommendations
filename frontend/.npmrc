# eslint-plugin-jsx-a11y@6.10.2's peer range tops out at eslint ^9; this project runs
# eslint ^10.6.0 (intentional -- tooling_spec_001_code_quality_security.md) and the
# plugin otherwise works fine on it. Without this, `npm ci` fails with ERESOLVE in any
# clean environment (CI, a fresh clone) even though `npm install` locally papers over it
# once node_modules already exists. Revisit/remove once jsx-a11y ships eslint 10 support.
legacy-peer-deps=true
