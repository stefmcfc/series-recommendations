# Copy to .env (gitignored) and fill in real values.
# Used by docker-compose.yml's backend service (tooling_spec_012) via `env_file: .env`.
# Both keys are optional -- the app starts and runs fine without them; only the OMDb
# lookup / TMDB recommendation endpoints 502 until set. See RUNBOOK.md's Environment
# Variables section for exactly which endpoints each key gates.

APP_OMDB_API_KEY=
APP_TMDB_API_KEY=
